# Copiază acest fișier ca .env.local și completează din Supabase → Project Settings → API Keys.
# Fără ele jocul merge normal, doar fără conturi și salvare în cloud. Pași: docs/SUPABASE.md
VITE_SUPABASE_URL=https://PROIECTUL-TAU.supabase.co
# Cheia publică (publishable / anon). NICIODATĂ cheia secretă (secret / service_role).
VITE_SUPABASE_KEY=
# Pune true după ce ai configurat Google în Supabase (docs/SUPABASE.md, pasul 4); până atunci butonul Google e ascuns.
VITE_GOOGLE_LOGIN=false
